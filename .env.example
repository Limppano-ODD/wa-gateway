# WhatsApp Gateway Environment Configuration
# Copy this file to .env and configure your values

# Node Environment (DEVELOPMENT or PRODUCTION)
NODE_ENV=PRODUCTION

# Application Port
PORT=3002

# Encryption key for WhatsApp credentials
# Generate a strong random key for production
KEY=

# Base URL for webhook callbacks
# Example: https://your-domain.com
WEBHOOK_BASE_URL=

# Admin user credentials
# IMPORTANT: Change these default values in production!
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Database file path
# Default: ./wa_gateway.db (current directory)
# Docker: /app/db/wa_gateway.db (mounted volume)
DB_PATH=./wa_gateway.db

# Token do handshake do webhook (invente uma string, coloque a mesma no painel do Meta)
META_VERIFY_TOKEN=
# Roteamento multi-tenant: phone_number_id -> { webhook (URL do app interno), token (Meta access token) }
# Ex: {"1202173422979697":{"webhook":"http://sac-interno:3022/webhooks/meta","token":"EAA..."}}
META_ROUTES={}
META_API_VERSION=v20.0

# Token do handshake do webhook (invente uma string; a mesma vai no painel do Meta)
META_VERIFY_TOKEN=
# Tokens de conexão da ponte: token secreto -> nome do app (o app disca com esse token)
# Ex: {"tok-sac-troque":"sac","tok-crm-troque":"crm"}
META_APP_TOKENS={}
# Roteamento: phone_number_id -> { app (dono do número), token (Meta access token p/ enviar) }
# Ex: {"1202173422979697":{"app":"sac","token":"EAA..."}}
META_ROUTES={}
META_API_VERSION=v20.0

# --- Bridge multi-canal (ponte /ingress/:tenant + WebSocket /bridge/agent) ---
# Cada tenant = um app/agente interno. nome -> { wsToken, channel, config }.
# channel = "whatsapp" | "teams". config varia por canal.
# whatsapp: { verifyToken, phoneNumberId, metaToken, apiVersion? }
# teams:    { appId, appPassword, tenantId }
# Ex: {"sac":{"wsToken":"tok-sac","channel":"whatsapp","config":{"verifyToken":"...","phoneNumberId":"1202...","metaToken":"EAA..."}}}
BRIDGE_TENANTS={}
