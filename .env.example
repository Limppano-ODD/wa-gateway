# WhatsApp Gateway Environment Configuration
# Copy this file to .env and configure your values

# Node Environment (DEVELOPMENT or PRODUCTION)
NODE_ENV=PRODUCTION

# Application Port
PORT=3002

# Encryption key for WhatsApp credentials
# Generate a strong random key for production
KEY=

# Base URL for webhook callbacks
# Example: https://your-domain.com
WEBHOOK_BASE_URL=

# Admin user credentials
# IMPORTANT: Change these default values in production!
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Database file path
# Default: ./wa_gateway.db (current directory)
# Docker: /app/db/wa_gateway.db (mounted volume)
DB_PATH=./wa_gateway.db

# Token do handshake do webhook (invente uma string, coloque a mesma no painel do Meta)
META_VERIFY_TOKEN=
# Roteamento multi-tenant: phone_number_id -> { webhook (URL do app interno), token (Meta access token) }
# Ex: {"1202173422979697":{"webhook":"http://sac-interno:3022/webhooks/meta","token":"EAA..."}}
META_ROUTES={}
META_API_VERSION=v20.0

# Token do handshake do webhook (invente uma string; a mesma vai no painel do Meta)
META_VERIFY_TOKEN=
# Tokens de conexão da ponte: token secreto -> nome do app (o app disca com esse token)
# Ex: {"tok-sac-troque":"sac","tok-crm-troque":"crm"}
META_APP_TOKENS={}
# Roteamento: phone_number_id -> { app (dono do número), token (Meta access token p/ enviar) }
# Ex: {"1202173422979697":{"app":"sac","token":"EAA..."}}
META_ROUTES={}
META_API_VERSION=v20.0

# --- Bridge multi-canal (ponte /ingress/:tenant + WebSocket /bridge/agent) ---
# Cada tenant = um app/agente interno. nome -> { wsToken, channel, config }.
# channel = "whatsapp" | "teams". config varia por canal.
# whatsapp: { verifyToken, phoneNumberId, metaToken, apiVersion? }
# teams:    { appId, appPassword, tenantId }
# Ex: {"sac":{"wsToken":"tok-sac","channel":"whatsapp","config":{"verifyToken":"...","phoneNumberId":"1202...","metaToken":"EAA..."}}}
BRIDGE_TENANTS={}

# --- Observabilidade (Fase 0) ---

# Token que o monitoramento (Gatus) usa em GET /status e GET /status/:session.
# Minimo 24 caracteres. Gere com: openssl rand -hex 24
# VAZIO = os endpoints devolvem 503 e o monitoramento alerta. Isso e proposital:
# fail-closed e barulhento e melhor que um verde que nao mede nada — foi um
# /health devolvendo 200 incondicional que escondeu 20 dias de queda.
STATUS_TOKEN=

# Backup do sqlite (usuarios, callback URLs e tokens de webhook vivem num
# arquivo so, num volume so). Roda no boot e a cada N horas. 0 desliga.
DB_BACKUP_INTERVAL_HOURS=24
# Quantas copias manter (as mais antigas sao apagadas).
DB_BACKUP_KEEP=7

# --- Login Microsoft / Entra ID (Fase 1) ---
# Vale SO para humano no browser. As rotas de maquina (/message, /profile,
# /session) continuam em Basic com credencial de servico.

# URL publica, usada para montar a redirect_uri. NAO e derivada do header Host
# de proposito: Host e controlado por quem chama, e redirect_uri forjada e o
# caminho classico para roubar o code.
PUBLIC_BASE_URL=https://wa-gateway.odd.com.br

AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Grupo de seguranca DEDICADO deste app (nao reaproveitar grupo de outro app:
# grupo compartilhado vira permissao acidental).
AZURE_AD_ADMIN_GROUP_ID=

# Break-glass: papeis de diretorio do Entra que entram como admin mesmo fora do
# grupo, lidos do claim `wids`. Default = Global Administrator e Privileged
# Role Administrator, que ja podem se conceder qualquer coisa no tenant.
ENTRA_BREAKGLASS_WIDS=62e90394-69f5-4237-9190-012177145e10,e8611ab8-c189-46e8-94e1-60213ab1f814

# Vida da sessao do humano, em horas.
WEB_SESSION_HOURS=12

# Enquanto true, o Basic continua valendo nas rotas humanas -- rede de
# seguranca da transicao: se o Entra cair, o painel nao fica inacessivel
# justamente quando alguem precisa re-parear uma sessao. Vira false na Fase 4.
AUTH_ALLOW_BASIC_FALLBACK=true
